# 쿠팡파트너스 OpenAPI 키 (https://partners.coupang.com/)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=thread_auto

# AI LLM API 키 (선택사항 - 미입력 시 내장 고전환 템플릿 엔진 가동)
GEMINI_API_KEY=
OPENAI_API_KEY=
